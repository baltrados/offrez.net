# Clé API Google Gemini (obligatoire)
GEMINI_API_KEY=

# Clé API RapidAPI pour Amazon (obligatoire)
RAPIDAPI_KEY=

# Environnement d'exécution
NODE_ENV=production

# Port d'écoute. Render l'injecte automatiquement : ne pas le définir sur Render
PORT=3000

# Modèle Gemini. Vide = modèle par défaut du code (gemini-3.5-flash-lite)
GEMINI_MODEL=

# Plafond global d'appels Gemini par jour, tous visiteurs confondus (0 = service coupé)
GEMINI_DAILY_LIMIT=100

# Plafond global d'appels RapidAPI par jour, tous visiteurs confondus (0 = service coupé)
RAPIDAPI_DAILY_LIMIT=150

# Plafond d'appels Gemini par jour et par adresse IP
GEMINI_DAILY_LIMIT_PER_IP=35

# Plafond d'appels RapidAPI par jour et par adresse IP
RAPIDAPI_DAILY_LIMIT_PER_IP=70

# Nombre de proxys devant l'application : 3 sur Render (Cloudflare, répartiteur Render, proxy local).
# Valeur par défaut du code : 3. Mettre 0 si l'application est exposée directement (sinon IP falsifiable).
TRUST_PROXY=3

# Fuseau horaire : les quotas journaliers repartent à minuit, heure de Paris
TZ=Europe/Paris
