{
    "name": "offrez",
    "version": "1.0.0",
    "description": "offrez - Trouvez le cadeau parfait en 30 secondes avec l'IA",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "node server.js",
        "test": "npm run test:unit && npm run test:integration",
        "test:unit": "node --test tests/unit/analyze.unit.js tests/unit/security.unit.mjs tests/unit/analyse-logic.unit.mjs",
        "test:integration": "node --test tests/integration/api-analyze.int.js tests/integration/api-search.int.js tests/integration/static.int.js tests/integration/misc.int.js tests/integration/quota.int.js",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui"
    },
    "dependencies": {
        "compression": "^1.8.1",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^5.3.0",
        "express-rate-limit": "^8.2.1",
        "helmet": "^8.3.0"
    },
    "engines": {
        "node": ">=20"
    },
    "keywords": [
        "gift",
        "recommendation",
        "ai",
        "gemini",
        "amazon"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@playwright/test": "^1.65.1"
    }
}
